<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<RootNamespace>Mic.Tests.Orm.Db</RootNamespace>
	</PropertyGroup>

	<!-- WHAT BOTH DB SUITES NEED AND NEITHER OWNS: the per-vendor fixtures, the vendor selection, and the base class
	     that gives a test its own database. A library rather than a test project — it declares no tests, and the two
	     suites that do reference it.

	     It carries MSTest.TestFramework but NOT the adapter or the test SDK: the base class uses [TestInitialize] and
	     Assert, and nothing here is discovered or run. -->
	<ItemGroup>
		<PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
	</ItemGroup>

	<!-- LINKED, not copied and not referenced. Both db suites need the same few helpers for reading an application's
	     startup reports, and so does the model-only suite — but `Mic.Tests.Orm` must NOT be referenced from here: it is
	     a test project, and ORM_31 kept it container-free on purpose.

	     A linked file compiles into both assemblies from one source, so the helpers cannot drift. Its namespace is
	     `Mic.Tests.Orm`, which everything here already sits inside (`Mic.Tests.Orm.Db`), so no using is needed. -->
	<ItemGroup>
		<Compile Include="..\Mic.Tests.Orm\TestReports.cs" Link="TestReports.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Orm\Mic.Orm\Mic.Orm.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.Postgres\Mic.Orm.Db.Postgres.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.Sqlite\Mic.Orm.Db.Sqlite.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.MySql\Mic.Orm.Db.MySql.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.SqlServer\Mic.Orm.Db.SqlServer.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.Oracle\Mic.Orm.Db.Oracle.csproj" />
		<ProjectReference Include="..\..\..\Orm\Mic.Orm.Db.Db2\Mic.Orm.Db.Db2.csproj" />
	</ItemGroup>

	<!-- The Db2 provider carries no driver: IBM ships one package per operating system, and the application
	     references the one of the system it runs on. Here the application is the suites, which get it through this
	     project, the native clidriver folder with it. -->
	<ItemGroup>
		<PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
		<PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
		<PackageReference Include="Net.IBM.Data.Db2-osx" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
	</ItemGroup>

</Project>
