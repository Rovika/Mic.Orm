<Project Sdk="Microsoft.NET.Sdk">

  <!-- The host: it chooses the database server, reads where the database is, connects the application and runs it.
       The provider package carries the server's driver, so the output folder holds everything the database tool
       needs to load the application: point mic-db/*.json at it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shop.Model\Shop.Model.csproj" />
    <!--#if (Postgres) -->
    <PackageReference Include="Mic.Orm.Db.Postgres" Version="MIC_VERSION" />
    <!--#endif -->
    <!--#if (MySql) -->
    <PackageReference Include="Mic.Orm.Db.MySql" Version="MIC_VERSION" />
    <!--#endif -->
    <!--#if (MsSql) -->
    <PackageReference Include="Mic.Orm.Db.SqlServer" Version="MIC_VERSION" />
    <!--#endif -->
    <!--#if (Oracle) -->
    <PackageReference Include="Mic.Orm.Db.Oracle" Version="MIC_VERSION" />
    <!--#endif -->
    <!--#if (SQLite) -->
    <PackageReference Include="Mic.Orm.Db.Sqlite" Version="MIC_VERSION" />
    <!--#endif -->
    <!--#if (Db2) -->
    <PackageReference Include="Mic.Orm.Db.Db2" Version="MIC_VERSION" />
    <!-- IBM ships its driver as a package per operating system, so the provider carries none and the host
         references the one of the system it is built on. -->
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="Net.IBM.Data.Db2-osx" Version="10.0.0.400" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
