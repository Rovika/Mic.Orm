<!-- Auto-imported by MSBuild for every project under src/ (depth-independent — survives the folder reorg, TASK_30).
     Replaces the former explicit <Import> of Imports/Common.proj. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.10.0-preview.1</Version>
    <!-- The assembly version holds the major and minor numbers of the version and nothing after them, so assemblies
         a patch apart bind to each other: the database tool hands an application its own Mic.Orm, and .NET binds a
         reference only to the same assembly version or a higher one. The file version carries the patch. -->
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace($(Version), '^(\d+\.\d+).*$', '$1.0.0'))</AssemblyVersion>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace($(Version), '^(\d+(\.\d+){1,3}).*$', '$1'))</FileVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <Copyright>Rovika Software, Inc</Copyright>
    <Authors>Rovika Software, Inc</Authors>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <RepositoryUrl>https://github.com/Rovika/Mic</RepositoryUrl>
  </PropertyGroup>
</Project>
